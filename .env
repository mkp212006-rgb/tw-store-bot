# ============================================================
# 6. E-MAIL DOS PEDIDOS CONCLUÍDOS
# Para Gmail, use uma senha de app; nunca a senha normal da conta.
# EMAIL_PEDIDOS_DESTINO aceita mais de um e-mail separado por vírgula.
# ============================================================
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_PEDIDOS_DESTINO=
EMAIL_REMETENTE_NOME=TW Store
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_USE_SSL=false
EMAIL_SMTP_TIMEOUT=30
EMAIL_ANEXAR_RELATORIO_PNG=true


# ============================================================
# 7. VERIFICAÇÕES ANTES DO PAGAMENTO
# Valida estoque, saldo da plataforma e links enviados pelo cliente.
# ============================================================
CHECK_ESTOQUE_ANTES_PAGAMENTO=true
MARGEM_SALDO_PLATAFORMA=0
CHECK_LINKS_FAIL_OPEN=false
LINK_CHECK_TIMEOUT=12


# ============================================================
# 8. PAGAMENTOS PENDENTES
# Use 0 em PAGAMENTOS_PENDENTES_EXPIRAR_MINUTOS para desativar.
# ============================================================
PAGAMENTOS_PENDENTES_EXPIRAR_MINUTOS=180
PAGAMENTOS_PENDENTES_LIMPEZA_INTERVALO=300


# ============================================================
# 9. CADASTRO E EQUIPE
# Regras de nova tentativa de cadastro e meta do cargo Tester.
# ============================================================
REGISTRO_NEGADO_TENTAR_NOVAMENTE_MINUTOS=5
META_SEMANAL_TESTER_REAIS=20,00


# ============================================================
# 10. INICIALIZAÇÃO E SERVIDOR
# PORT normalmente é definido automaticamente pelo Railway.
# A limpeza inicial evita reenvio de pedidos antigos após um deploy.
# ============================================================
LIMPAR_PEDIDOS_PENDENTES_AO_INICIAR=true
